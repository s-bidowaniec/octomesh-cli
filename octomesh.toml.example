# Octomesh Configuration
# After `octo install`, use an ABSOLUTE adapter_runner, e.g.
# adapter_runner = ["python3", "/home/you/.local/share/octomesh/adapters/run_adapter.py"]
max_depth = 2
default_cooldown_secs = 300
adapter_runner = ["uv", "run", "--project", "adapters", "python", "-m", "octomesh_adapters.runner"]

# Optional sections (AF-01..AF-06):
# [mesh]
# project = "myproj"            # explicit project id (else git origin slug, else "default")
# presence_ttl_secs = 120       # presence rows older than this are STALE/pruned
# busy_ttl_secs = 300           # busy peers recover automatically after this
# [project]
# name = "myproj"
# allowed_connectors = ["github", "drive"]   # connector gateway allowlist ("*" = all)
# [budgets]
# default_max_prompt_chars = 20000           # context budget; per-peer override:
#                                            # [peers.x] max_prompt_chars = 5000

[roles]
coder = ["codex", "claude", "agy", "vibe"]
reviewer = ["agy", "vibe", "codex", "claude"]
fast = ["vibe", "agy", "codex", "claude"]
all = ["claude", "codex", "agy", "vibe"]
demo = ["mock_primary", "mock_backup"]

[peers.claude]
adapter = "claude"
command = "claude"
timeout_secs = 180
cooldown_secs = 300

[peers.codex]
adapter = "codex"
command = "codex"
timeout_secs = 180
cooldown_secs = 180

[peers.vibe]
adapter = "vibe"
command = "vibe"
timeout_secs = 180
cooldown_secs = 180

[peers.agy]
adapter = "agy"
command = "agy"
timeout_secs = 180
cooldown_secs = 180

[peers.mock_primary]
adapter = "mock"
timeout_secs = 5
cooldown_secs = 60

[peers.mock_backup]
adapter = "mock"
timeout_secs = 5
cooldown_secs = 60

# Optional Konsole peer. Set the bus destination and session path for your
# own window. Konsole stages the prompt so you can submit it in that window.
# [peers.agy_window]
# adapter = "dbus"
# command = "gdbus"
# args = [
#   "bus=org.kde.konsole",
#   "path=/Sessions/2",
#   "method=org.kde.konsole.Session.sendText",
#   "allow_terminal_paste=true",
# ]
# timeout_secs = 120
# cooldown_secs = 60
